# Environment Configuration

# Providers API Keys (automatically loaded by provider name)
GROQ_API_KEY="XXXX"
HF_TOKEN="XXXX"

# Default LLM Configuration (used when creating agents without specifying a profile)
LLM_DEFAULT_PROVIDER=groq
LLM_DEFAULT_MODEL=llama-3.1-8b-instant
LLM_DEFAULT_TEMPERATURE=0.4
LLM_DEFAULT_MAX_TOKENS=8192

# Additional Profiles (optional)
LLM_PROFILE_EXECUTOR_PROVIDER=groq
LLM_PROFILE_EXECUTOR_MODEL=llama-3.1-8b-instant
LLM_PROFILE_EXECUTOR_TEMPERATURE=0.3
LLM_PROFILE_EXECUTOR_MAX_TOKENS=4000

LLM_PROFILE_SUPERVISOR_PROVIDER=groq
LLM_PROFILE_SUPERVISOR_MODEL=llama-3.1-8b-instant
LLM_PROFILE_SUPERVISOR_TEMPERATURE=0.3
LLM_PROFILE_SUPERVISOR_MAX_TOKENS=4000

# CSV and files for RAG Data Paths (relative to project root)
DATA_PATH=data/
CACHE_DIR=.cache/vector_stores

# MCP Server Configuration (optional)
POKEAPI_MCP_SERVER_URL=false
POKEAPI_MCP_ENABLED=false

# Logging Configuration
LOG_LEVEL=DEBUG

# Summarization Configuration
SUMMARIZATION_ENABLED=true
SUMMARIZATION_TRIGGER_TOKENS=4000
SUMMARIZATION_KEEP_MESSAGES=20
SUMMARIZATION_MODEL=llama-3.1-8b-instant
SUMMARIZATION_PROVIDER=groq
